@@ -36,6 +36,23 @@ export const inject = [
   'slots', 'locale', 'inputTriggers', 'remote', 'remote.dynamicCordisRunner', 'dynamicCordisRunner',
 ]
 
+/**
+ * sessionStorage flag armed by the frontend-refresh settings action
+ * (@deepseek-ai/dsh-client-ui-settings-restart). Kept as a shared string
+ * literal: cross-plugin value imports are forbidden by the client bundle
+ * purity gate. Consumed once per page load.
+ */
+const REATTACH_FLAG = 'dsh:reattach-cordis-runs'
+
+/** Whether the current page load was a frontend-only refresh asking to re-attach active runs. */
+function reattachArmed(): boolean {
+  try {
+    return sessionStorage.getItem(REATTACH_FLAG) === '1'
+  } catch {
+    return false
+  }
+}
+
 /** Mount every Cordis browser surface over the shared Host inventory. */
 export function apply(ctx: ClientContext): void {
   ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'ui-cordis: dictionaries')
@@ -68,7 +85,34 @@ export function apply(ctx: ClientContext): void {
   ctx.effect(() => inventory.subscribe(() => {
     const snapshot = inventory.getSnapshot()
     if (snapshot.read) runner.reconcileApprovals(snapshot.rows)
-  }), 'ui-cordis: reconcile pending approvals')
+    // One-shot re-attach after a frontend-only refresh (see
+    // @deepseek-ai/dsh-client-ui-settings-restart's REATTACH_FLAG): restore
+    // the Client halves of active dynamic Plugins so creation-mode hot
+    // plugins survive the reload. The Host half stays untouched — the
+    // runner's attach path reuses the live run instead of restarting it.
+    if (snapshot.read && reattachArmed()) {
+      try {
+        sessionStorage.removeItem(REATTACH_FLAG)
+      } catch {
+        // Storage refusal must not block the re-attach.
+      }
+      for (const row of snapshot.rows) {
+        const run = row.activeRun
+        if (run === undefined) continue
+        if (row.latestRun?.approvalRequestId !== undefined) continue
+        if (runner.isLoaded(row.pluginId)) continue
+        const pkg = row.packages.find(candidate => candidate.packageId === run.packageId)
+        if (pkg?.hasClientHalf !== true) continue
+        void runner.startUserRun({
+          agentId: row.agentId,
+          pluginId: row.pluginId,
+          packageId: run.packageId,
+          mode: 'run',
+          hasClientHalf: true,
+        })
+      }
+    }
+  }), 'ui-cordis: reconcile pending approvals and reattach runs after frontend refresh')
 
   ctx.remote.$on('cordis/dynamic-package', () => { inventory.refresh() })
   ctx.remote.$on('cordis/dynamic-retract', () => { inventory.refresh() })
